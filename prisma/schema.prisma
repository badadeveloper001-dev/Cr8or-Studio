generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Project {
  id          String          @id @default(cuid())
  name        String
  description String
  framework   String
  language    String
  repository  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  tasks       Task[]
  globals     GlobalMemory[]
  locals      LocalAgentMemory[]
  workspaces  Workspace[]
}

model Task {
  id          String   @id @default(cuid())
  projectId   String
  agentId     String
  title       String
  status      String
  confidence  Float?
  output      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model GlobalMemory {
  id          String   @id @default(cuid())
  projectId   String
  key         String
  value       String
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model LocalAgentMemory {
  id          String   @id @default(cuid())
  projectId   String
  agentId     String
  note        String
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Workspace {
  id                  String   @id @default(cuid())
  projectId           String   @unique
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runtimeType         String
  provider            String?
  providerWorkspaceId String?
  repositoryUrl       String?
  projectName         String?
  branch              String?
  state               String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  lastActiveAt        DateTime?
}

enum AuthMethod {
  ACCESS_CODE
  PASSKEY
}

enum AuthRateLimitScope {
  SOURCE
  GLOBAL
}

// PostgreSQL CHECK constraints in the migration enforce the singleton ID,
// positive credential version, and the 32-byte future WebAuthn user handle.
// All three authentication tables use RLS with no public policies. Prisma does
// not represent RLS or grants; preserve the custom SQL in future migrations.
model OwnerCredential {
  id                String        @id @default("owner")
  accessCodeHash    String
  credentialVersion Int           @default(1)
  webAuthnUserHandle Bytes         @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  sessions          AuthSession[]
}

// tokenHash contains lowercase SHA-256 hex of a random 256-bit session token.
// This digest is not the hashing algorithm used for the owner's access code.
model AuthSession {
  id                   String          @id @default(cuid())
  ownerId              String
  owner                OwnerCredential @relation(fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tokenHash            String          @unique @db.Char(64)
  credentialVersion    Int
  authenticationMethod AuthMethod
  authenticatedAt      DateTime
  createdAt            DateTime        @default(now())
  expiresAt            DateTime
  revokedAt            DateTime?
  lastActiveAt         DateTime?

  @@index([ownerId, revokedAt])
  @@index([expiresAt])
}

// Each source/global identity has one current window. Database upserts update
// attempts atomically; expiresAt covers both the window and any cooldown.
model AuthRateLimit {
  scope           AuthRateLimitScope
  keyHash         String             @db.Char(64)
  attempts        Int                @default(0)
  windowStartedAt DateTime
  windowExpiresAt DateTime
  cooldownUntil   DateTime?
  expiresAt       DateTime
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@id([scope, keyHash])
  @@index([expiresAt])
}

enum CommandOperationStatus {
  RESERVED
  RUNNING
  SUCCEEDED
  FAILED
  TIMED_OUT
  CANCELLED
  UNKNOWN
}

// Server-internal coordination and audit metadata only. The migration adds RLS,
// lifecycle constraints, and a partial unique index allowing one unresolved
// operation per exact provider workspace. UNKNOWN deliberately holds that slot
// until trusted operator reconciliation. No session token or output is stored.
// Historical project/workspace identifiers are snapshots, not authorization.
model CommandOperation {
  id                    String                 @id @db.Uuid
  projectId             String                 @db.VarChar(256)
  workspaceId           String                 @db.VarChar(256)
  commandKey            String                 @db.VarChar(64)
  actorId               String                 @db.VarChar(64)
  executionId           String                 @db.Uuid
  status                CommandOperationStatus @default(RESERVED)
  createdAt             DateTime               @default(now())
  startedAt             DateTime?
  completedAt           DateTime?
  updatedAt             DateTime               @updatedAt
  exitCode              Int?
  cancellationConfirmed Boolean                @default(false)
  cleanupConfirmed      Boolean                @default(false)

  @@index([workspaceId, createdAt])
  @@index([completedAt])
}


enum CommandApprovalStatus {
  PENDING
  APPROVED
  DENIED
  REVOKED
}

// Durable, one-use command approvals. Identity fields are immutable snapshots,
// deliberately without cascading foreign keys so session/project cleanup does
// not erase the approval audit trail. Every use revalidates live records.
// SQL adds RLS, bounded lifetime, catalogue and lifecycle CHECK constraints.
model CommandApproval {
  id                      String                @id @db.Uuid
  ownerId                 String                @default("owner")
  sessionId               String                @db.VarChar(128)
  credentialVersion       Int
  projectId               String                @db.VarChar(256)
  workspaceRecordId       String                @db.VarChar(256)
  providerWorkspaceId     String                @db.VarChar(256)
  commandKey              String                @db.VarChar(64)
  status                  CommandApprovalStatus @default(PENDING)
  createdAt               DateTime              @default(now())
  expiresAt               DateTime
  decidedAt               DateTime?
  revokedAt               DateTime?
  consumedAt              DateTime?
  consumedOperationId     String?               @unique @db.Uuid
  consumedActorId         String?               @db.VarChar(64)

  @@index([sessionId, createdAt])
  @@index([expiresAt])
}

// Operation-specific Git approvals use the same lifecycle and session-generation
// binding as command approvals. Scope is a canonical server-resolved snapshot;
// the digest binds the exact operation fields without retaining file contents.
model GitApproval {
  id                  String                @id @db.Uuid
  ownerId             String                @default("owner")
  sessionId           String                @db.VarChar(128)
  credentialVersion   Int
  projectId           String                @db.VarChar(256)
  workspaceRecordId   String                @db.VarChar(256)
  providerWorkspaceId String                @db.VarChar(256)
  repositoryKey       String                @db.VarChar(256)
  operationKey        String                @db.VarChar(64)
  scope               Json
  scopeDigest         String                @db.Char(64)
  status              CommandApprovalStatus @default(PENDING)
  createdAt           DateTime              @default(now())
  expiresAt           DateTime
  decidedAt           DateTime?
  revokedAt           DateTime?
  consumedAt          DateTime?
  consumedOperationId String?               @unique @db.Uuid
  consumedActorId     String?               @db.VarChar(64)

  @@index([sessionId, createdAt])
  @@index([expiresAt])
}

// Audit snapshots do not grant authority. SQL partial unique indexes retain one
// unresolved operation per repository AND provider workspace. UNKNOWN is never
// automatically retried or reclaimed; operator reconciliation is required.
model GitOperation {
  id                    String                 @id @db.Uuid
  projectId             String                 @db.VarChar(256)
  workspaceId           String                 @db.VarChar(256)
  repositoryKey         String                 @db.VarChar(256)
  operationKey          String                 @db.VarChar(64)
  scopeDigest           String                 @db.Char(64)
  actorId               String                 @db.VarChar(64)
  executionId           String                 @db.Uuid
  status                CommandOperationStatus @default(RESERVED)
  createdAt             DateTime               @default(now())
  startedAt             DateTime?
  completedAt           DateTime?
  updatedAt             DateTime               @updatedAt
  exitCode              Int?
  cancellationConfirmed Boolean                @default(false)
  cleanupConfirmed      Boolean                @default(false)

  @@index([repositoryKey, createdAt])
  @@index([workspaceId, createdAt])
  @@index([completedAt])
}


enum WorkspaceLifecycleStatus {
  RESERVED
  DISPATCHED
  SUCCEEDED
  FAILED
  CANCELLED
  UNKNOWN
}

// Durable owner/session/generation-bound approval snapshots; no cascading
// relations can erase the audit trail. SQL enforces one-use and ten-minute TTL.
model WorkspaceLifecycleApproval {
  id                  String                @id @db.Uuid
  ownerId             String                @default("owner")
  sessionId           String                @db.VarChar(128)
  credentialVersion   Int
  projectId           String                @db.VarChar(256)
  workspaceRecordId   String                @db.VarChar(256)
  providerWorkspaceId String?               @db.VarChar(256)
  action              String                @db.VarChar(16)
  scope               Json
  scopeDigest         String                @db.Char(64)
  status              CommandApprovalStatus @default(PENDING)
  createdAt           DateTime              @default(now())
  expiresAt           DateTime
  decidedAt           DateTime?
  revokedAt           DateTime?
  consumedAt          DateTime?
  consumedOperationId String?               @unique @db.Uuid

  @@index([sessionId, createdAt])
  @@index([expiresAt])
}

// No provider resource is registered merely because a reservation exists.
// UNKNOWN retains its partial unique slots until exact-resource reconciliation.
// Dispatch attempts are one-shot; timeout never authorizes an automatic retry.
model WorkspaceLifecycleOperation {
  id                  String                   @id @db.Uuid
  ownerId             String                   @default("owner")
  sessionId           String                   @db.VarChar(128)
  credentialVersion   Int
  projectId           String                   @db.VarChar(256)
  workspaceRecordId   String                   @db.VarChar(256)
  providerWorkspaceId String?                  @db.VarChar(256)
  providerResourceId  String?                  @db.VarChar(256)
  action              String                   @db.VarChar(16)
  scope               Json
  scopeDigest         String                   @db.Char(64)
  idempotencyKey      String                   @db.Uuid
  approvalId          String?                  @unique @db.Uuid
  status              WorkspaceLifecycleStatus @default(RESERVED)
  attempts            Int                      @default(0)
  createdAt           DateTime                 @default(now())
  dispatchedAt        DateTime?
  completedAt         DateTime?
  updatedAt           DateTime                 @updatedAt
  reconciledAt        DateTime?
  reconciliationAttempts Int                   @default(0)
  lastReconciliationAt DateTime?

  @@unique([sessionId, idempotencyKey])
  @@index([projectId, createdAt])
  @@index([providerWorkspaceId, createdAt])
  @@index([createdAt])
}
